{
  "name": "nucleo/nucleo",
  "description": "Nucleo: AI-first block builder for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "sabberworm/php-css-parser": "^9.5"
  },
  "require-dev": {
    "opis/json-schema": "^2.4",
    "php-stubs/woocommerce-stubs": "^11.2",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": { "psr-4": { "Nucleo\\": "src/" } },
  "autoload-dev": { "psr-4": { "Nucleo\\Tests\\": "tests/" } },
  "config": { "optimize-autoloader": true, "classmap-authoritative": false, "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    } },
  "scripts": {
    "test:unit": "phpunit --testsuite unit",
    "test:acceptance": "phpunit --testsuite acceptance",
    "stan": "phpstan analyse --memory-limit=1G"
  }
}
